+def configured_model(fallback: str | None = None) -> str:
+    model = os.environ.get("AI_SCIENTIST_MODEL") or fallback
+    if not model:
+        raise ValueError("AI_SCIENTIST_MODEL is not configured.")
+    return model
+
+
+def extract_message_text(content: Any) -> str:
+    if isinstance(content, str):
+        text = content.strip()
+    elif isinstance(content, list):
+        parts = []
+        for block in content:
+            value = block.get("text") if isinstance(block, dict) else getattr(block, "text", None)
+            if value:
+                parts.append(value)
+        text = "\n".join(parts).strip()
+    else:
+        text = ""
+    if not text:
+        raise ValueError("The OpenAI-compatible endpoint returned empty message content.")
+    return text
+
