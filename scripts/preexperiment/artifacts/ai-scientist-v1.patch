+def is_openai_compatible_model(model):
+    """Return whether this run uses the configured OpenAI-compatible endpoint."""
+    return os.environ.get("AI_SCIENTIST_OPENAI_COMPATIBLE") == "1" or model.startswith("qwen")
+
+
+def extract_message_text(content):
+    """Normalize OpenAI-compatible response content and reject empty responses."""
+    if isinstance(content, str):
+        text = content.strip()
+    elif isinstance(content, list):
+        parts = []
+        for block in content:
+            value = block.get("text") if isinstance(block, dict) else getattr(block, "text", None)
+            if value:
+                parts.append(value)
+        text = "\n".join(parts).strip()
+    else:
+        text = ""
+    if not text:
+        raise ValueError("The OpenAI-compatible endpoint returned empty message content.")
+    return text
+
+
+def aider_model_name(model):
+    """Map a configured model to Aider's provider-qualified model name."""
+    if is_openai_compatible_model(model):
+        return f"openai/{model}"
+    if model == "deepseek-coder-v2-0724":
+        return "deepseek/deepseek-coder"
+    if model == "deepseek-reasoner":
+        return "deepseek/deepseek-reasoner"
+    if model == "llama3.1-405b":
+        return "openrouter/meta-llama/llama-3.1-405b-instruct"
+    return model
+
+
