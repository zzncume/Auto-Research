# Copy this file outside the Git repository to
# /home/user/projects/autoresearch/secrets/qwen.env, set permissions to 600,
# and fill only the value between the quotes below.
export DASHSCOPE_API_KEY=''

export AI_SCIENTIST_MODEL='qwen3.8-max'
export AI_SCIENTIST_BASE_URL='https://ws-7nvj28bhf31rri5v.cn-beijing.maas.aliyuncs.com/compatible-mode/v1'
export AI_SCIENTIST_OPENAI_COMPATIBLE='1'
export AI_SCIENTIST_API_KEY="${DASHSCOPE_API_KEY}"

# Aider (used by AI-Scientist v1) reads the OpenAI-compatible settings below.
export OPENAI_API_KEY="${DASHSCOPE_API_KEY}"
export OPENAI_API_BASE="${AI_SCIENTIST_BASE_URL}"
export OPENAI_BASE_URL="${AI_SCIENTIST_BASE_URL}"

# ARIS-Code executor and HTTP reviewer. Both intentionally use this run's model.
export EXECUTOR_PROVIDER='openai'
export EXECUTOR_BASE_URL="${AI_SCIENTIST_BASE_URL}"
export EXECUTOR_API_KEY="${DASHSCOPE_API_KEY}"
export ARIS_REVIEWER_PROVIDER='custom'
export ARIS_REVIEWER_BASE_URL="${AI_SCIENTIST_BASE_URL}"
export ARIS_REVIEWER_AUTH_TOKEN="${DASHSCOPE_API_KEY}"
export ARIS_REVIEWER_MODEL="${AI_SCIENTIST_MODEL}"
