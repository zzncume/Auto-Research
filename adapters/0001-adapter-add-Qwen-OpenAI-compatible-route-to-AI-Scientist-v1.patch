+                msg, client, model, system_message, print_debug=False,
+                msg_history=msg_history, temperature=temperature,
+            )
+            content.append(c)
+            new_msg_history.append(hist)
+    elif 'gpt' in model:
         new_msg_history = msg_history + [{"role": "user", "content": msg}]
         response = client.chat.completions.create(
             model=model,
@@ -183,6 +230,16 @@ def get_response_from_llm(
                 ],
             }
         ]
+    elif is_openai_compatible_model(model):
